# Copie este arquivo para .env.local e ajuste os valores.
# Para um novo cliente, basta trocar NEXT_PUBLIC_CLIENT_SLUG.

NEXT_PUBLIC_SUPABASE_URL=https://qpndbkgaaxtxipamjijg.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_CLIENT_SLUG=advocacia-demo

# Host canônico, sem barra no fim (ex.: https://www.exemplo.adv.br).
# Alimenta metadataBase, canonical, og:url e og:image. Sem ela, cai em
# `clients.domain` e depois em http://localhost:3000 — o que serve para
# desenvolver, mas NÃO para publicar.
# NEXT_PUBLIC_* é inlinada em build: mudar exige redeploy, não basta restart.
NEXT_PUBLIC_SITE_URL=
